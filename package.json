{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "node --import tsx server/index.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node --import tsx server/index.ts",
    "health": "node --import tsx healthscript.ts",
    "generate:entrypoints": "node scripts/generate-entrypoints.mjs",
    "validate:classification": "node --import tsx scripts/validate-classification.mjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tests/memory-sandbox.test.ts tests/sandbox-functional.test.ts tests/command-api.test.ts tests/voice-delivery.test.ts tests/groq-recovery.test.ts",
    "test:services": "node scripts/test-services.mjs",
    "test:website": "npm run build && node --import tsx --test tests/public-website.test.ts",
    "test:settings": "npm run build && node tests/settings-ui.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "eventemitter3": "^5.0.4",
    "express": "^4.22.3",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^7.23.0",
    "p-queue": "^9.3.3",
    "playwright": "^1.63.0",
    "quickjs-emscripten": "0.32.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tsx": "^4.21.0",
    "turndown": "^7.2.4",
    "vite": "^6.2.3",
    "ws": "^8.22.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@sparticuz/chromium": "153.0.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.5",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
