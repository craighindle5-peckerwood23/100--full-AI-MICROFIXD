# Microfixd OS Environment Configuration

# Server & Runtime
PORT=3000
NODE_ENV=production
CORS_ORIGINS=

# Supabase (Database, Auth, pgvector Memory & UI State)
VITE_SUPABASE_URL=https://caiiajbxslllrgeexbaw.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://caiiajbxslllrgeexbaw.supabase.co
SUPABASE_ANON_KEY=

# Security & RBAC Access Tokens (Optional for single-tenant, required for multi-tenant)
ADMIN_TOKEN=
OPERATOR_TOKEN=
SYSTEM_TOKEN=

# Optional Supabase Auth login screen (requires accounts_schema.sql in Supabase).
VITE_AUTH_MODE=

# AI & LLM Providers (Server-side)
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub Integration
GITHUB_TOKEN=
VITE_GITHUB_TOKEN=

# MCP Configuration
MCP_MANIFEST_PATH=mcp-manifest.json

# Server only: never prefix privileged keys with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Completion budgets (1..16384); defaults allow long explanations.
BRAIN_MAX_TOKENS=10000
RESPONSE_MAX_TOKENS=10000
# Session-scoped retrieval: whole records, with explicit omitted-count diagnostics.
MEMORY_RETRIEVAL_LIMIT=30
MEMORY_CONTEXT_MAX_CHARS=60000
# Optional system Chromium path; leave unset for Playwright-managed Chromium.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
# Keep enabled in production.
PLAYWRIGHT_CHROMIUM_SANDBOX=true

# Branding is fixed at build time; leave empty for Microfixd defaults.
VITE_BRAND_PRODUCT_NAME=
VITE_BRAND_SHORT_NAME=
VITE_BRAND_TAGLINE=
VITE_BRAND_TOPBAR_BADGE=
VITE_BRAND_BOOT_KERNEL_LABEL=
VITE_BRAND_VERSION_LABEL=
VITE_BRAND_SUPPORT_EMAIL=
VITE_BRAND_LOGO_PATH=
VITE_BRAND_COLOR_PRIMARY=
VITE_BRAND_COLOR_ACCENT=
VITE_BRAND_COLOR_BACKGROUND=
VITE_BRAND_COLOR_SURFACE=
VITE_BRAND_COLOR_BORDER=
VITE_BRAND_COLOR_TEXT=
VITE_BRAND_COLOR_TEXT_MUTED=
