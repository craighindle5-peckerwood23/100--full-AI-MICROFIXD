# Microfixd OS Environment Configuration

# Server & Runtime
PORT=3000
NODE_ENV=production
CORS_ORIGINS=

# Supabase (Database, Auth, pgvector Memory & UI State)
VITE_SUPABASE_URL=https://caiiajbxslllrgeexbaw.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://caiiajbxslllrgeexbaw.supabase.co
SUPABASE_ANON_KEY=

# Security & RBAC Access Tokens (Optional for single-tenant, required for multi-tenant)
ADMIN_TOKEN=
OPERATOR_TOKEN=
SYSTEM_TOKEN=

# AI & LLM Providers (Server-side)
GEMINI_API_KEY=
VITE_GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub Integration
GITHUB_TOKEN=
VITE_GITHUB_TOKEN=

# MCP Configuration
MCP_MANIFEST_PATH=mcp-manifest.json

# Server only: never prefix privileged keys with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional maximum completion budget (1..8192).
BRAIN_MAX_TOKENS=2048
# Optional system Chromium path; leave unset for Playwright-managed Chromium.
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
# Keep enabled in production.
PLAYWRIGHT_CHROMIUM_SANDBOX=true
